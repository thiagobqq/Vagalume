{
  "Uploads": {
    "BasePath": "/app/uploads"
  },
  "Busca": {
    "IntervaloMinutos": 5,
    "MaxConcorrencia": 3,
    "HttpTimeoutSegundos": 30,
    "TimeoutExecucaoSegundos": 300,
    "TimeoutFonteSegundos": 60,
    "FilaCapacidade": 100,
    "UserAgent": "VagalumeBot/1.0 (+https://vagalume.app)",
    "Scraping": {
      "DelayMs": 500,
      "MaxPaginas": 2,
      "MaxItens": 25,
      "MaxDetalhes": 10,
      "MaxTermos": 4,
      "UserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
