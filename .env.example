# ===== App =====
ASPNETCORE_ENVIRONMENT=Development

# ===== Seed do admin =====
Seed__Admin__Email=admin@example.receba
Seed__Admin__Senha=example123

# ===== Banco =====
ConnectionStrings__DefaultConnection=

# ===== JWT =====
Jwt__Key=
Jwt__Issuer=
